# Backend configuration for local development. Copy to .env (never committed) and adjust.
# Every variable is optional in APP_ENV=local; see backend/README.md for the full list.

APP_ENV=local
PORT=8080

DATABASE_URL=jdbc:postgresql://localhost:5432/language_platform
DATABASE_USER=app
DATABASE_PASSWORD=app

# Private content (the owner's own books and samples) lives outside the repository:
# CONTENT_DIR/{reading,listening,writing,audio}/
CONTENT_DIR=~/LanguagePlatform/content

# Signed-in users whose verified email is listed here see private content; everyone else gets 404.
OWNER_EMAILS=you@example.com

# Local only: this bearer token signs in as the first OWNER_EMAILS address without Firebase.
# The server refuses to start when it is set outside APP_ENV=local.
DEV_AUTH_TOKEN=

# Public sample audio.
AUDIO_BASE_URL=http://localhost:9000/audio

# Private audio: "local" streams CONTENT_DIR/audio through the API, "r2" returns presigned Cloudflare R2 URLs.
# Outside APP_ENV=local this is required and must be "r2".
AUDIO_STORAGE=local
# Base URL the apps use to reach this API (http://10.0.2.2:8080 from the Android emulator).
API_BASE_URL=http://localhost:8080
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
