<configuration>
  <condition class="ch.qos.logback.core.boolex.ExpressionPropertyCondition">
    <expression>isNull("APP_ENV") || propertyEquals("APP_ENV", "") || propertyEquals("APP_ENV", "local")</expression>
  </condition>
  <if>
    <then>
      <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
          <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} [%X{requestId}] - %msg%n</pattern>
        </encoder>
      </appender>
    </then>
    <else>
      <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
      </appender>
    </else>
  </if>
  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
  <logger name="io.netty" level="WARN"/>
</configuration>
