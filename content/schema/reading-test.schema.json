{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reading-test.schema.json",
  "title": "ReadingTest",
  "description": "An IELTS Reading test. Matches com.app.platform.language.core.model.ReadingTest.",
  "type": "object",
  "required": ["id", "title", "timeLimitMinutes", "passages"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "module": { "enum": ["academic", "general_training"], "default": "academic" },
    "title": { "type": "string", "minLength": 1 },
    "timeLimitMinutes": { "type": "integer", "minimum": 1, "maximum": 60 },
    "passages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/passage" }
    }
  },
  "$defs": {
    "passage": {
      "type": "object",
      "required": ["id", "title", "paragraphs", "questionGroups"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["text"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "pattern": "^[A-Z]$" },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "questionGroups": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/questionGroup" }
        }
      }
    },
    "questionGroup": {
      "type": "object",
      "required": ["id", "type", "instruction", "questions"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": {
          "enum": ["multiple_choice", "true_false_not_given", "yes_no_not_given", "sentence_completion"]
        },
        "instruction": { "type": "string" },
        "maxWords": { "type": "integer", "minimum": 1, "maximum": 5 },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/question" }
        }
      }
    },
    "question": {
      "type": "object",
      "required": ["id", "number", "prompt", "acceptedAnswers"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "number": { "type": "integer", "minimum": 1, "maximum": 40 },
        "prompt": { "type": "string" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "text"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string", "pattern": "^[A-Z]$" },
              "text": { "type": "string" }
            }
          }
        },
        "acceptedAnswers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "explanation": {
          "anyOf": [
            { "$ref": "#/$defs/explanation" },
            { "type": "string", "deprecated": true, "description": "Legacy plain-text explanation, read as { text }." }
          ]
        }
      }
    },
    "explanation": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1, "description": "Why the answer is correct, in Vietnamese." },
        "evidence": {
          "oneOf": [{ "$ref": "#/$defs/passageEvidence" }, { "$ref": "#/$defs/transcriptEvidence" }]
        },
        "paraphrases": {
          "type": "array",
          "items": { "$ref": "#/$defs/paraphrase" }
        },
        "trap": { "type": "string", "minLength": 1, "description": "The distractor learners usually pick, in Vietnamese." }
      }
    },
    "passageEvidence": {
      "description": "Reading evidence: a verbatim quote from the paragraph with this label in the question's passage.",
      "type": "object",
      "required": ["type", "paragraphId", "quote"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "passage" },
        "paragraphId": { "type": "string", "pattern": "^[A-Z]$" },
        "quote": { "type": "string", "minLength": 1 }
      }
    },
    "transcriptEvidence": {
      "description": "Listening evidence: a verbatim quote from the transcript of the question's section in this time range.",
      "type": "object",
      "required": ["type", "sectionNumber", "startSeconds", "endSeconds", "quote"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "transcript" },
        "sectionNumber": { "type": "integer", "minimum": 1, "maximum": 4 },
        "startSeconds": { "type": "integer", "minimum": 0 },
        "endSeconds": { "type": "integer", "minimum": 1 },
        "quote": { "type": "string", "minLength": 1 }
      }
    },
    "paraphrase": {
      "description": "Wording in the question or its options and the matching wording in the source, both verbatim English.",
      "type": "object",
      "required": ["inQuestion", "inSource"],
      "additionalProperties": false,
      "properties": {
        "inQuestion": { "type": "string", "minLength": 1 },
        "inSource": { "type": "string", "minLength": 1 }
      }
    }
  }
}
