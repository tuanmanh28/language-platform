-- Downloaded tests, cached for offline practice.
CREATE TABLE CachedReadingTest (
    id TEXT NOT NULL PRIMARY KEY,
    json TEXT NOT NULL,
    updatedAt INTEGER NOT NULL
);

-- On-device attempt history. A later phase syncs it to the server via a sync queue.
CREATE TABLE ReadingAttempt (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    testId TEXT NOT NULL,
    correctCount INTEGER NOT NULL,
    totalQuestions INTEGER NOT NULL,
    band REAL NOT NULL,
    answersJson TEXT NOT NULL,
    createdAt INTEGER NOT NULL
);

CREATE INDEX ReadingAttempt_testId ON ReadingAttempt(testId);

upsertTest:
INSERT OR REPLACE INTO CachedReadingTest(id, json, updatedAt) VALUES (?, ?, ?);

selectTest:
SELECT json FROM CachedReadingTest WHERE id = ?;

selectAllTests:
SELECT json FROM CachedReadingTest ORDER BY id;

insertAttempt:
INSERT INTO ReadingAttempt(testId, correctCount, totalQuestions, band, answersJson, createdAt)
VALUES (?, ?, ?, ?, ?, ?);

countAttempts:
SELECT COUNT(*) FROM ReadingAttempt WHERE testId = ?;
